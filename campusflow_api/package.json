{
  "name": "campusflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST simulée de CampusFlow (json-server + jeton)",
  "scripts": {
    "start": "node server.js",
    "start:ouvert": "node -e \"require('fs').copyFileSync('db.json', 'db.runtime.json')\" && json-server --watch db.runtime.json --host 0.0.0.0 --port 3000"
  },
  "devDependencies": {
    "json-server": "0.17.4"
  }
}
